    "review_status": "PASS_SCOPED"
  },
  {
    "id": "S09-E02",
    "topic": "PV translation",
    "answer": "present_value = future_value / (1 + rate) ** periods; equivalently growth_factor=(1+rate)**periods then present_value=future_value/growth_factor. Require a meaningful nonzero factor and compatible periods/rate.",
    "source": "books/book-01-python-foundations-for-financial-mathematics/chapter-01/1.09-expressions-precedence-and-mathematical-translation.md",
    "source_sha256": "94bc04bcf6266a1cee79f3906a86e31e02deb98c6d5993170b64d7a085f7e5ee",
